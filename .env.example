# 网盘拉新唯一配置文件
# 复制�?.env 并填写实际值；.env 已被 .gitignore 忽略�?# 所有配置统一在此文件，不再支�?config.yaml�?
# 全局默认
COUNT=5
CACHE_EXPIRE_HOURS=24
TARGET_FOLDER=转存资源


# ===== 数据来源：本地资源池 / PanSou API =====
# 默认优先读取项目根目录的「资源池.json」（由 tools/list_resources.py 导出），
# 读取失败或不存在时自动回退到 PanSou API。
# false 时强制走 API
LOCAL_POOL_ENABLED=true
# 相对项目根目录，也可填绝对路径
RESOURCE_POOL_FILE=资源池.json

# ===== PanSou 服务地址（不填则用默认值）=====
# 修改端口后无需改任何代码，Python 侧与启动器共用这份配置。
# 用 127.0.0.1 而非 localhost，避免 IPv6 解析差异
PANSOU_HOST=127.0.0.1
PANSOU_PORT=8888
# PANSOU_API_URL=                  # 设置后完全覆盖上面两项拼出的搜索地址
# PANSOU_ENABLED_PLUGINS=          # 留空则自动读取 pansou/docker-compose.yml 的插件列表
# PANSOU_CHANNELS=                 # 同上，留空则读 docker-compose.yml

# ── 转存前链接有效性预检 ──────────────────────────────────────────────
# 推送前先用 PanSou 的 /api/check/links 验一遍，失效链接自动跳过并顺延取下一条。
# 游标只会消费有效条目；死链记入 data/share/dead_links.txt 供下次直接排除。
# CLI 可用 --check-links / --no-check-links 单次覆盖。
# 设为 false 全局关闭预检
PANSOU_CHECK_ENABLED=true
# PANSOU_CHECK_TIMEOUT=30           # 单次检测请求超时（秒）
# PANSOU_CHECK_BATCH=50             # 单次请求最多带几条链接（PanSou 侧有上限）


# 企业微信机器人（两种字段名都支持）
WECHAT_WEBHOOK_URL=

# 百度网盘
BAIDU_COOKIE=
# 扫码时页面里取到的 bdstoken（自动写入，用于转存后的引流清理）
BAIDU_BDSTOKEN=
# BAIDU_COUNT=          # 留空则用全局 COUNT
# BAIDU_TARGET_FOLDER=  # 留空则用全局 TARGET_FOLDER

# 迅雷网盘
# 获取 refresh_token：浏览器登录 https://pan.xunlei.com → F12 Network → 筛选 auth/token → 复制 refresh_token
XUNLEI_REFRESH_TOKEN=
# XUNLEI_COUNT=          # 留空则用全局 COUNT
# XUNLEI_TARGET_FOLDER=  # 留空则用全局 TARGET_FOLDER（迅雷用网盘内完整路径，如 /转存资源）

# 夸克网盘
QUARK_COOKIE=
# kuake-v1.5.0 CLI 专用（同 QUARK_COOKIE，CLI 会自动读 .env）
KUAKE_COOKIE=
# QUARK_COUNT=          # 留空则用全局 COUNT
# QUARK_KUAKE_CLI=      # 留空或填 auto = 按当前系统/架构自动选择（推荐）
#                       #   填具体路径 = 显式指定，跳过自动识别
#                       #   支持 Windows / Linux(x64/arm64) / macOS(x64, arm64 走 Rosetta)
QUARK_FOLDER_FID=0
# 引流不再支持本地文件：旧的 QUARK_YINLIU_PDF / QUARK_YINLIU_FILES 已移除，
# 只保留下面的 YINLIU_FOLDER（复制网盘里已有的文件夹）。

# ===== 引流插入（复制网盘上已有的文件夹，三平台通用）=====
# 每个资源转存成功后，把这个文件夹整份复制到该资源所在的文件夹里，
# 别人打开分享链接就能直接看到。填网盘内的绝对路径；留空则不插入。
YINLIU_FOLDER=
# 平台级覆盖（可选，不填就用上面的 YINLIU_FOLDER）
QUARK_YINLIU_FOLDER=
BAIDU_YINLIU_FOLDER=
XUNLEI_YINLIU_FOLDER=
# 总开关；目标目录已有同名文件夹时跳过（改 false 则每次多复制一份副本）
YINLIU_ENABLED=true
YINLIU_SKIP_EXISTS=true

# ===== 引流清理（转存后删掉别人留的广告文件，三平台通用）=====
# 判定保守：文件名命中关键词才删；带别人微信号的正课只改名、不删。
CLEAN_YINLIU=true
# 自定义关键词（逗号分隔）；留空 = 用内置词库（微信/加群/扫码/领取/公众号…）
CLEAN_YINLIU_KEYWORDS=
# 排除名单：命中就保留。自己的引流文件夹名会自动加入，一般不用手填
CLEAN_YINLIU_EXCLUDES=
# 把文件名里别人的微信号/QQ 换成这个号
CLEAN_YINLIU_MY_CONTACT=kds3566
# 激进模式：没有关键词、但「小于 N MB 的 PDF/图片」也删，可能误伤正经小文档
CLEAN_YINLIU_MAX_MB=5
CLEAN_YINLIU_AGGRESSIVE=false

# ===== 飞书群机器人（可选，与企业微信并行推送消息）=====
# 群设置 → 群机器人 → 添加自定义机器人，复制其 Webhook 地址
# 与企业微信是两个独立通道：两者都填则两边都推，只填一个就只推一个
FEISHU_WEBHOOK_URL=

# ===== 飞书多维表格（可选，开启后自动写入）=====
# 在 https://open.feishu.cn/app 创建自建应用
# 需要权限: wiki:wiki:readonly + bitable:app
# 还需要把应用添加为目标文档的协作者（wiki 页面右上角... → 添加文档应用）
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# wiki 页面 URL 里 /wiki/ 后面那串
FEISHU_WIKI_NODE_TOKEN=
# 多维表格 URL 里 ?table= 后面那串
FEISHU_TABLE_ID=

# ===== QQ 群推送（OneBot 协议端，可选）=====
# 不是 QQ 官方机器人：官方群机器人主动推送有严格频控（每群每月个位数），
# 做不到"转存完自动往群里发一条"。这里走 OneBot，协议端常见选择 NapCat / LLOneBot。
# 部署后协议端会暴露一个 HTTP 端口（NapCat 默认 3000），填在下面即可。
# 注意：协议端本质是登录一个小号，属非官方用法，有封号风险，别用主号。
QQ_ENABLED=false
# 例：http://127.0.0.1:3000（协议端和本程序同一台机器时用 127.0.0.1）
ONEBOT_URL=
# 群号：QQ 群资料页能看到的那串数字
QQ_GROUP_ID=
# 协议端若设置了 access token 就填这里；没设就留空
ONEBOT_ACCESS_TOKEN=

# ===== 工作台访问控制 =====
# WEB_PASSWORD 留空时，工作台只允许本机(127.0.0.1)访问，外网会返回 403。
# 要在外网用浏览器打开，必须设一个密码（账号默认 admin）。
# 生成随机密码:  openssl rand -base64 12
WEB_USER=admin
WEB_PASSWORD=
